# Configure on the server, never in browser code.
OPENAI_API_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Supabase Auth user UUIDs, comma-separated.
CLASSROOM_TEACHER_IDS=
# Set to 1 only when the app is served through HTTPS.
CLASSROOM_SECURE_COOKIES=0
# Optional developer-only classroom without Supabase.
CLASSROOM_LOCAL_PREVIEW=0
